# Correo de contacto (/acerca-de). Copia este archivo a .env.local y rellénalo.
# Las variables SMTP_* y CONTACT_* solo se leen en el servidor: nunca uses el prefijo NEXT_PUBLIC_ en ellas.

# --- DESARROLLO: Mailtrap (sandbox, captura los correos sin entregarlos) ---
# Credenciales en Mailtrap > Email Testing > Inboxes > SMTP Settings.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=88177eb789c414
SMTP_PASS=cb49f457b00c29

# --- PRODUCCIÓN, opción A: servidor SMTP local SIN autenticación ---
# Solo para un MTA local (localhost) que no sea accesible desde fuera.
# Deja SMTP_USER y SMTP_PASS sin definir (o comentados).
# SMTP_HOST=localhost
# SMTP_PORT=25
# SMTP_SECURE=false

# --- PRODUCCIÓN, opción B: SMTP con usuario y contraseña ---
# SMTP_HOST=smtp.tu-proveedor.com
# SMTP_PORT=587          # 465 con SMTP_SECURE=true
# SMTP_SECURE=false
# SMTP_USER=usuario
# SMTP_PASS=contraseña

# --- Destino y remitente (obligatorios en todos los entornos) ---
CONTACT_TO=equipo@vault.gg
CONTACT_FROM="Arcade Vault <no-reply@vault.gg>"


# --- Supabase (conexión; ver specs/04-conexion-supabase.md) ---
# Dashboard > Project Settings > API Keys. Usa SOLO la clave publicable (sb_publishable_...).
# Nunca pongas aquí la clave service_role ni una clave secreta.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
